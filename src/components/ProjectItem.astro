---
import MediaLink from "./MediaLink.astro";

interface Props {
    title: string;
    body: string;
    subtitle?: string;
    tags?: string[];
    searchText?: string;
    links?: {
        label: string;
        href: string;
        target?: string;
    }[];
}

const { title, body, subtitle, tags = [], searchText, links = [] } = Astro.props;
---

<li
    class="mb-4 break-inside-avoid w-full rounded-lg p-5 bg-base-200"
    data-search-text={searchText}
>
    <div>
        <h2 class="text-2xl font-semibold text-base-950">{title}</h2>

        {
            subtitle && (
                <p class="text-base leading-tight italic text-base-700">
                    {subtitle}
                </p>
            )
        }

        <p class="mt-3 text-base leading-snug text-base-950">{body}</p>

        {
            tags.length > 0 && (
                <ul class="mt-4 flex flex-wrap gap-2">
                    {tags.map((tag) => (
                        <li class="rounded-full bg-base-300 px-3 py-1 text-xs font-medium text-base-950">
                            {tag}
                        </li>
                    ))}
                </ul>
            )
        }

        {
            links.length > 0 && (
                <hr class="my-3 border-base-300" />

                <div class="flex flex-wrap gap-3">
                    {links.map((link) => (
                        <MediaLink url={link.href} label={link.label} />
                    ))}
                </div>
            )
        }
    </div>
</li>

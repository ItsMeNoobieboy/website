---
interface Props {
    title: string;
    body: string;
    href: string;
    target: string;
}

const { href, title, body, target } = Astro.props;
---

<li
    class="rounded-lg p-5 bg-size-[400%] bg-base-200 bg-linear-45 hover:from-accent-400 hover:via-accent-200 hover:via-30% hover:to-base-50 hover:to-60% transition-all duration-300">
    {
        href ? (
            <a class="hover:no-underline" href={href} target={target}>
                <h2 class="m-0 text-base-950 text-xl font-semibold">{title}</h2>
                <p class="text-base-950">{body}</p>
            </a>
        ) : (
            <div>
                <h2 class="m-0 text-base-950 text-xl font-semibold">{title}</h2>
                <p class="text-base-950">{body}</p>
            </div>
        )
    }
</li>

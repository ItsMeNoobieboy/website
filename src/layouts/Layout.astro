---
import "../styles/global.css";

interface Props {
    title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="description" content="Astro description" />
        <meta name="viewport" content="width=device-width" />
        <!-- <link rel="icon" type="image/svg+xml" href="/favicon.svg" /> -->
        <link rel="icon" type="image/gif" href="/pfp.gif" />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
    </head>
    <body>
        <nav
            class="bg-accent text-slate-50 selection:bg-slate-50 selection:text-accent font-bold text-center p-3 grid justify-items-end place-items-center grid-flow-col grid-rows-1">
            <div class="inline text-3xl p-2 justify-self-start">
                Yancheng Zhao
            </div>
            <ul class="flex font-bold m-3 text-xl">
                <li>
                    <a
                        class="p-2 m-2 rounded-md hover:underline decoration-2"
                        href="/">Home</a
                    >
                </li>
                <li>
                    <a
                        class="p-2 m-2 rounded-md hover:underline decoration-2"
                        href="/projects">Projects</a
                    >
                </li>
                <li>
                    <a
                        class="p-2 m-2 rounded-md hover:underline decoration-2"
                        href="/writing">Writing</a
                    >
                </li>
            </ul>
        </nav>

        <slot />
    </body>
</html>

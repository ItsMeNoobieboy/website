---
import FunPage from "../layouts/FunPage.astro";
---

<FunPage title="Word Counter">
    <h1 class="text-3xl font-semibold mb-4">Word Counter</h1>

    <h2 class="text-xl font-medium mb-2">
        Word Count: <span id="wordCount">0</span>
    </h2>

    <textarea
        id="textInput"
        placeholder="Enter your text here..."
        class="w-full
        max-w-4xl h-[70vh] p-4 border border-black/15 rounded-md text-base mb-6"
    ></textarea>
</FunPage>

<script type="module">
    const textInput = document.getElementById("textInput");
    const wordCount = document.getElementById("wordCount");

    textInput.addEventListener("input", () => {
        const text = textInput.value.trim();
        const words = text ? text.split(/\s+/) : [];
        wordCount.textContent = words.length.toString();
    });
</script>

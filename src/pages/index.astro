---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Home">
    👋 ’Sup, I’m
    <h1 class="text-7xl font-bold mb-4">Yancheng.</h1>
    <p>
        Welcome to my website! I’m a teenager living in the Boston area, and I
        love programming and writing.
    </p>
    <br />
    <p>This site is a work in progress. In the meantime, you can:</p>
    <br />
    <div>
        <h2 class="text-2xl font-semibold">
            Check out some of my links below:
        </h2>
        <ul>
            <li>
                <a href="https://github.com/ItsMeNoobieboy">GitHub</a>
            </li>
            <li>
                <a href="https://itsmenoobieboy.itch.io/">Itch.io</a>
            </li>
            <li><a href="https://devpost.com/yzhao">Devpost</a></li>
        </ul>
    </div>
    <br />
    <div>
        <h2 class="text-2xl font-semibold">Contact me at:</h2>
        <ul>
            <li>
                Email: <button
                    class="text-accent-500 cursor-pointer hover:underline decoration-2"
                    id="email">yancheng [at] duck [dot] com</button
                > (<span id="emailCopyText">Click to copy</span>)
            </li>
            <li>
                Discord: <button
                    class="text-accent-500 cursor-pointer hover:underline decoration-2"
                    id="discord">itsmenoobieboy</button
                > (<span id="discordCopyText">Click to copy</span>)
            </li>
            <li>
                Hack Clubber? Message me on Slack: <button
                    class="text-accent-500 cursor-pointer hover:underline decoration-2"
                    id="slack">@Yancheng</button
                > (<span id="slackCopyText">Click to copy</span>)
            </li>
        </ul>
    </div>
</Layout>

<script type="module">
    const copyIds = ["email", "discord", "slack"];

    copyIds.forEach((id) => {
        document.getElementById(id).addEventListener("click", async () => {
            let text = document.getElementById(id).innerText;
            if (!text) return;
            if (id === "email") {
                text = text.replace(" [at] ", "@").replace(" [dot] ", ".");
            }

            await navigator.clipboard.writeText(text);

            const copyText = document.getElementById(id + "CopyText");
            if (!copyText) return;
            copyText.innerText = "Copied!";

            setTimeout(() => {
                copyText.innerText = "Click to copy";
            }, 3000);
        });
    });
</script>
